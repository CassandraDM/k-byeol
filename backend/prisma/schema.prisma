// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(50) // min 2 chars enforced at DTO level
  email     String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255)
  avatar    String?  @db.VarChar(255)
  role      String   @default("user") @db.VarChar(20)
  bio       String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  preferences     UserPreferences?
  organizedEvents Event[]              @relation("OrganizedEvents")
  participations  EventParticipation[]
  conversations      ConversationParticipant[]
  messages           Message[]
  ownedConversations Conversation[]           @relation("OwnedConversations")

  @@map("users")
}

model KpopGroup {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(100)
  slug String @unique @db.VarChar(100)

  userPreferences UserPreferencesGroup[]

  @@map("kpop_groups")
}

model UserPreferences {
  id     Int @id @default(autoincrement())
  userId Int @unique @map("user_id")

  // City from geo.api.gouv.fr
  cityCode       String? @map("city_code") @db.VarChar(10)
  cityName       String? @map("city_name") @db.VarChar(255)
  cityPostalCode String? @map("city_postal_code") @db.VarChar(10)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  groups UserPreferencesGroup[]

  @@map("user_preferences")
}

enum EventType {
  RANDOM_PLAY_DANCE
  FESTIVAL
  ON_STAGE
  IN_PUBLIC
}

model Event {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(255)
  type        EventType
  latitude    Float
  longitude   Float
  address     String    @db.VarChar(500)
  date        DateTime  @db.Date
  time        String    @db.VarChar(10)
  description String
  imageUrl    String?   @map("image_url") @db.VarChar(500)
  organizerId Int       @map("organizer_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  organizer      User               @relation("OrganizedEvents", fields: [organizerId], references: [id], onDelete: Cascade)
  participations EventParticipation[]

  @@map("events")
}

model EventParticipation {
  userId    Int      @map("user_id")
  eventId   Int      @map("event_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@map("event_participations")
}

enum ConversationType {
  PRIVATE
  GROUP
  CREW
}

enum ParticipantRole {
  MEMBER
  WRITER
  OWNER
}

model Conversation {
  id              Int              @id @default(autoincrement())
  type            ConversationType @default(PRIVATE)
  name            String?          @db.VarChar(255)
  ownerId         Int?             @map("owner_id")
  lastMessageText String?          @map("last_message_text")
  lastMessageAt   DateTime?        @map("last_message_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  owner        User?                    @relation("OwnedConversations", fields: [ownerId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  userId         Int             @map("user_id")
  conversationId Int             @map("conversation_id")
  role           ParticipantRole @default(MEMBER)
  joinedAt       DateTime        @default(now()) @map("joined_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([userId, conversationId])
  @@map("conversation_participants")
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int      @map("conversation_id")
  senderId       Int      @map("sender_id")
  text           String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model UserPreferencesGroup {
  preferencesId Int @map("preferences_id")
  groupId       Int @map("group_id")

  preferences UserPreferences @relation(fields: [preferencesId], references: [id], onDelete: Cascade)
  group       KpopGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([preferencesId, groupId])
  @@map("user_preferences_groups")
}
