// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique @db.VarChar(50) // min 2 chars enforced at DTO level
  email         String   @unique @db.VarChar(100)
  password      String   @db.VarChar(255)
  avatar        String?  @db.VarChar(255)
  role          String   @default("user") @db.VarChar(20)
  bio           String?
  emailVerified Boolean  @default(false) @map("email_verified")
  // How the account authenticates: "email" (password) | "google" | "apple"
  provider      String   @default("email") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  preferences     UserPreferences?
  organizedEvents Event[]              @relation("OrganizedEvents")
  participations  EventParticipation[]
  conversations      ConversationParticipant[]
  messages           Message[]
  ownedConversations Conversation[]           @relation("OwnedConversations")
  groupRequests      GroupRequest[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  deviceTokens        DeviceToken[]
  reportsSubmitted    Report[]                 @relation("ReportsSubmitted")
  blocksMade          Block[]                  @relation("BlocksMade")
  blocksReceived      Block[]                  @relation("BlocksReceived")
  deletedMessages     Message[]                @relation("DeletedMessages")
  following           Follow[]                 @relation("Following")
  followers           Follow[]                 @relation("Followers")

  @@map("users")
}

enum ReportTargetType {
  USER
  EVENT
}

/// A moderation report filed by a user against another user or an event.
/// Kept even if the target disappears, so moderators keep the audit trail.
model Report {
  id         Int              @id @default(autoincrement())
  reporterId Int              @map("reporter_id")
  targetType ReportTargetType @map("target_type")
  targetId   Int              @map("target_id")
  reason     String
  status     String           @default("pending") @db.VarChar(20)
  createdAt  DateTime         @default(now()) @map("created_at")

  reporter User @relation("ReportsSubmitted", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([targetType, targetId])
  @@map("reports")
}

/// One user blocking another. Visibility is cut both ways: the pair simply
/// stops seeing each other, whichever side filed the block.
model Block {
  blockerId Int      @map("blocker_id")
  blockedId Int      @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

/// One user following another. The row is directional — following someone
/// does not make them follow back. Two rows pointing at each other is what
/// "friends" means here, so friendship is derived, never stored.
model Follow {
  followerId  Int      @map("follower_id")
  followingId Int      @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

/// An Expo push token for one of a user's devices. A user can be signed in on
/// several devices, so this is a one-to-many — every row is one installation.
model DeviceToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  // e.g. "ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]"
  token     String   @unique @db.VarChar(255)
  platform  String?  @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  // SHA-256 hash of the raw token — the raw token is only ever sent by email
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  // SHA-256 hash of the raw verification code
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model KpopGroup {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(100)
  slug String @unique @db.VarChar(100)

  userPreferences UserPreferencesGroup[]

  @@map("kpop_groups")
}

model GroupRequest {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  userId    Int      @map("user_id")
  status    String   @default("pending") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("group_requests")
}

model UserPreferences {
  id     Int @id @default(autoincrement())
  userId Int @unique @map("user_id")

  // City from geo.api.gouv.fr
  cityCode       String? @map("city_code") @db.VarChar(10)
  cityName       String? @map("city_name") @db.VarChar(255)
  cityPostalCode String? @map("city_postal_code") @db.VarChar(10)

  /// When true, events organised by someone you blocked are kept off the map
  /// and out of search results. Defaults to hiding — the protective posture.
  hideBlockedEvents Boolean @default(true) @map("hide_blocked_events")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  groups UserPreferencesGroup[]

  @@map("user_preferences")
}

enum EventType {
  RANDOM_PLAY_DANCE
  FESTIVAL
  ON_STAGE
  IN_PUBLIC
}

model Event {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(255)
  type        EventType
  latitude    Float
  longitude   Float
  address     String    @db.VarChar(500)
  date        DateTime  @db.Date
  time        String    @db.VarChar(10)
  description String
  imageUrl    String?   @map("image_url") @db.VarChar(500)
  organizerId Int       @map("organizer_id")
  // Set once the "starts in 1 hour" push has gone out, so it only fires once.
  reminderSentAt DateTime? @map("reminder_sent_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  organizer      User               @relation("OrganizedEvents", fields: [organizerId], references: [id], onDelete: Cascade)
  participations EventParticipation[]
  conversation   Conversation?

  @@map("events")
}

model EventParticipation {
  userId    Int      @map("user_id")
  eventId   Int      @map("event_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@map("event_participations")
}

enum ConversationType {
  PRIVATE
  GROUP
  CREW
}

enum ParticipantRole {
  /// Read-only.
  MEMBER
  /// May post.
  WRITER
  /// May post, delete anyone's messages, and mute or remove people below them.
  MODERATOR
  /// May post, moderate, and set other people's roles — everyone's but the
  /// owner's.
  ADMIN
  /// The event's organizer. Exactly one per thread, and unassignable.
  OWNER
}

model Conversation {
  id              Int              @id @default(autoincrement())
  type            ConversationType @default(PRIVATE)
  name            String?          @db.VarChar(255)
  ownerId         Int?             @map("owner_id")
  /// Set when this thread is an event's group chat. Unique: one event, one
  /// conversation. Its presence is what makes the thread organizer-controlled
  /// — only OWNER and WRITER may post.
  eventId         Int?             @unique @map("event_id")
  lastMessageText String?          @map("last_message_text")
  lastMessageAt   DateTime?        @map("last_message_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  owner        User?                    @relation("OwnedConversations", fields: [ownerId], references: [id], onDelete: SetNull)
  event        Event?                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  userId         Int             @map("user_id")
  conversationId Int             @map("conversation_id")
  role           ParticipantRole @default(MEMBER)
  /// Silenced independently of the role, so muting somebody does not cost
  /// them the rights they were given.
  isMuted        Boolean         @default(false) @map("is_muted")
  /// When the mute lifts itself. NULL while muted means it has no end date,
  /// which is what a permanent mute is.
  mutedUntil     DateTime?       @map("muted_until")
  joinedAt       DateTime        @default(now()) @map("joined_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([userId, conversationId])
  @@map("conversation_participants")
}

model Message {
  id             Int       @id @default(autoincrement())
  conversationId Int       @map("conversation_id")
  senderId       Int       @map("sender_id")
  text           String
  /// Set the first time the author rewrites the message, so the thread can
  /// show that what is on screen is not what was originally sent.
  editedAt       DateTime? @map("edited_at")
  /// Soft delete: the row survives moderation so the audit trail does, while
  /// the text stops being served. NULL means the message is live.
  deletedAt      DateTime? @map("deleted_at")
  /// Who removed it — the author themselves, or a moderator.
  deletedById    Int?      @map("deleted_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  deletedBy    User?        @relation("DeletedMessages", fields: [deletedById], references: [id], onDelete: SetNull)

  @@map("messages")
}

model UserPreferencesGroup {
  preferencesId Int @map("preferences_id")
  groupId       Int @map("group_id")

  preferences UserPreferences @relation(fields: [preferencesId], references: [id], onDelete: Cascade)
  group       KpopGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([preferencesId, groupId])
  @@map("user_preferences_groups")
}
