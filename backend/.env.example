# ─────────────────────────────────────────────────
#  K-별 Backend — Environment variables
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────

# ─── Runtime ─────────────────────────────────────────────────────
# "production" turns on strict TLS verification for the database and stops
# CORS from falling back to the local dev origins. Leave unset in development.
NODE_ENV=

# ─── JWT ─────────────────────────────────────────────────────────
# Secret used to sign access tokens. Required — the app refuses to boot
# without it, and rejects anything shorter than 32 characters. Generate one
# with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-secret"

# ─── Database (Prisma + Supabase PostgreSQL) ────────────────────
# Connection string with PgBouncer pooling (used by Prisma at runtime)
DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<database>?pgbouncer=true"

# Direct connection string (used by Prisma Migrate — bypasses PgBouncer)
DIRECT_URL="postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require"

# CA certificate used to verify the database TLS chain. Either the PEM
# contents or a path to a .crt file. Optional in development (verification is
# skipped, with a warning on every boot); in production the chain must verify.
DATABASE_CA_CERT=

# ─── Server ──────────────────────────────────────────────────────
# Server port (optional, defaults to 3000)
PORT=3000

# Browser origins allowed to call the API, comma-separated. Native builds
# aren't subject to CORS — this only matters for the Expo web build.
# Unset in development = the local Expo dev servers. Unset in production =
# no browser origin is allowed (never "*").
CORS_ORIGINS=

# ─── Email (password reset) ──────────────────────────────────────
# Transport is chosen automatically: Resend (if RESEND_API_KEY is set) →
# SMTP (if SMTP_* are set) → console logging (dev fallback, nothing sent).

# Resend (recommended). Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# SMTP (alternative to Resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false          # true for port 465, false for 587/STARTTLS
SMTP_USER=
SMTP_PASS=

# "From" address. Must be on a domain you verified in Resend.
# For quick testing without a verified domain, use onboarding@resend.dev
# (Resend only delivers that sender to your own account email).
MAIL_FROM="K-별 <onboarding@resend.dev>"

# Unused since the reset flow moved from a deep link to a 6-digit code sent by
# email. Kept documented so an old .env doesn't look like it's missing a value.
# APP_RESET_URL="mobile://reset-password"

# ─── Push notifications (Expo) ───────────────────────────────────
# Optional. Only needed if you enable "Enhanced Security for Push
# Notifications" on your Expo account — otherwise pushes send unauthenticated.
# Create one at https://expo.dev/accounts/<account>/settings/access-tokens
EXPO_ACCESS_TOKEN=

# ─── Supabase (social login) ─────────────────────────────────────
# Used to validate the Supabase access token sent by the mobile app after a
# Google/Apple OAuth login. The anon key is public and safe to ship.
SUPABASE_URL="https://<your-ref>.supabase.co"
SUPABASE_ANON_KEY="<your-supabase-anon-key>"
