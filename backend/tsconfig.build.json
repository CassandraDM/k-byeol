{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Pin the root, don't let TypeScript infer it. Without this the inferred
    // root is the whole backend/ folder — because prisma.config.ts, scripts/
    // and prisma/seed.ts sit next to src/ — and the entry point lands at
    // dist/src/main.js while `start:prod` looks for dist/main.js.
    "rootDir": "./src"
  },
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "generated",
    "scripts",
    "prisma",
    "prisma.config.ts",
    "**/*spec.ts"
  ]
}
