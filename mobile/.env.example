# ────────────────────────────────────────────────────────────
#  K-별 Mobile — Environment variables
#  Copy this file to .env and fill in your value.
#  Never commit .env to version control.
# ────────────────────────────────────────────────────────────

# Supabase anon key, used for the Google / Apple sign-in flow and for uploading
# avatars and event covers to Storage. It is public by design — Supabase row
# level security is what protects the data, not this key.
#
# EXPO_PUBLIC_ is not decoration: only variables with that prefix are readable
# from app code, and their values are baked into the bundle at build time.
#
# The build servers do not have this file. Set the same variable as an EAS
# environment variable too, or a production build throws on first sign-in.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Points the app at a specific API instead of the one it works out on
# its own — your machine in development, the Railway deployment in a release
# build. Useful to run against production from a phone that is not on your
# network.
# EXPO_PUBLIC_API_URL=https://k-byeol-production.up.railway.app
